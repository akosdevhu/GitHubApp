{
  "expo": {
    "name": "OctoGit",
    "slug": "GitHubApp",
    "version": "0.0.0",
    "scheme": "octogit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akosdevhu.githubapp"
    },
    "android": {
      "package": "com.akosdevhu.githubapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "9c539a2a-0604-465b-a4fc-f6d5eedabd05"
      }
    }
  }
}
